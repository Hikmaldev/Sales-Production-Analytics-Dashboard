# Copy this file to .env and fill in real values.
# DATABASE_URL  – pooled connection string used by the API at runtime.
# DIRECT_URL    – direct (non-pooled) connection used by Prisma migrations.
# JWT_SECRET    – long random string used to sign session tokens.
# PORT          – API port (default 3001).
#
# Optional, for the test suite: create .env.test with a dedicated database
# (never the development one) so `npm test` never touches real data:
#   TEST_DATABASE_URL=postgresql://user:password@test-host.example.com/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host-pooler.example.com/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@host.example.com/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
PORT=3001
